# Copia este archivo a .env y ajusta los valores
# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=smartCook
MONGODB_COLLECTION=recetas_duracion
MONGODB_TIMEOUT_MS=8000

# Fallback local (solo si NO defines MONGODB_URI)
RECETAS_JSON_PATH=./recetas.json

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
FLASK_DEBUG=1
